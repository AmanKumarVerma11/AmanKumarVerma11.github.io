# Copy to .env.local for local dev; set the same keys in the Vercel project.

# Server-side. Required by api/send-email.js — without it the contact form
# returns 500. Get one at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# Client-side (inlined into the bundle at build time — never put a secret here).
# The "Resume" link is hidden from the header entirely when this is unset.
VITE_RESUME_LINK=https://example.com/link-to-your-resume.pdf
